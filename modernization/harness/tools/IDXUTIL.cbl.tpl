       IDENTIFICATION DIVISION.
       PROGRAM-ID. @PGM@.
      * Generated by build.sh. Converts between a line-sequential text
      * file (SEQFILE) and a GnuCOBOL indexed file (IDXFILE).
      * Usage: @PGM@ LOAD|UNLOAD
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SEQ-FILE ASSIGN TO SEQFILE
                  ORGANIZATION IS LINE SEQUENTIAL
                  FILE STATUS IS SEQ-ST.
           SELECT IDX-FILE ASSIGN TO IDXFILE
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS IDX-KEY
@ALTKEY@
                  FILE STATUS IS IDX-ST.
       DATA DIVISION.
       FILE SECTION.
       FD  SEQ-FILE.
       01  SEQ-REC                 PIC X(@RECLEN@).
       FD  IDX-FILE.
       01  IDX-REC.
@LAYOUT@
       WORKING-STORAGE SECTION.
       01  SEQ-ST                  PIC XX.
       01  IDX-ST                  PIC XX.
       01  WS-MODE                 PIC X(8).
       01  WS-EOF                  PIC X VALUE 'N'.
       01  WS-COUNT                PIC 9(9) VALUE 0.
       PROCEDURE DIVISION.
           ACCEPT WS-MODE FROM ARGUMENT-VALUE
           EVALUATE WS-MODE
               WHEN 'LOAD'   PERFORM DO-LOAD
               WHEN 'UNLOAD' PERFORM DO-UNLOAD
               WHEN OTHER
                   DISPLAY '@PGM@: USAGE LOAD|UNLOAD' UPON SYSERR
                   STOP RUN RETURNING 8
           END-EVALUATE
           STOP RUN.
       DO-LOAD.
           OPEN INPUT SEQ-FILE
           OPEN OUTPUT IDX-FILE
           PERFORM CHECK-OPEN
           PERFORM UNTIL WS-EOF = 'Y'
               READ SEQ-FILE
                   AT END MOVE 'Y' TO WS-EOF
                   NOT AT END
                       MOVE SEQ-REC TO IDX-REC
                       WRITE IDX-REC
                           INVALID KEY
                               DISPLAY '@PGM@: WRITE FAILED ' IDX-ST
                                       ' KEY ' IDX-KEY UPON SYSERR
                               STOP RUN RETURNING 8
                       END-WRITE
                       ADD 1 TO WS-COUNT
               END-READ
           END-PERFORM
           CLOSE SEQ-FILE IDX-FILE.
       DO-UNLOAD.
           OPEN INPUT IDX-FILE
           OPEN OUTPUT SEQ-FILE
           PERFORM CHECK-OPEN
           PERFORM UNTIL WS-EOF = 'Y'
               READ IDX-FILE NEXT RECORD
                   AT END MOVE 'Y' TO WS-EOF
                   NOT AT END
                       MOVE IDX-REC TO SEQ-REC
                       WRITE SEQ-REC
                       ADD 1 TO WS-COUNT
               END-READ
           END-PERFORM
           CLOSE SEQ-FILE IDX-FILE.
       CHECK-OPEN.
           IF SEQ-ST NOT = '00' OR IDX-ST NOT = '00'
               DISPLAY '@PGM@: OPEN FAILED SEQ=' SEQ-ST ' IDX=' IDX-ST
                       UPON SYSERR
               STOP RUN RETURNING 8
           END-IF.
